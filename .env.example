# Copy this file to .env and adjust as needed. Every variable below is
# consumed by docker-compose.yml (see PRD §21.5) to bring up the local
# backing services: Postgres+PostGIS+pgvector, Redis, MinIO and Mailpit.

# --- Postgres (Postgres 16 + PostGIS + pgvector + pg_trgm + citext + pgcrypto) ---
POSTGRES_USER=convene
POSTGRES_PASSWORD=convene
POSTGRES_DB=convene
# Host port the container's 5432 is published on.
POSTGRES_PORT=5432
# Connection string used by `pnpm db:migrate`/`pnpm db:rollback` and by
# apps/api — must match the POSTGRES_* values above when pointed at the
# docker-compose stack.
DATABASE_URL=postgres://convene:convene@localhost:5432/convene

# --- Redis (7-alpine, append-only persistence) ---
# Host port the container's 6379 is published on.
REDIS_PORT=6379
# Connection string used by apps/api — must match REDIS_PORT above when
# pointed at the docker-compose stack.
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=convene
MINIO_ROOT_PASSWORD=convene123
# Bucket created automatically by the minio-init service on first start.
MINIO_BUCKET=convene-media
# Host port for the S3 API.
MINIO_API_PORT=9000
# Host port for the web console.
MINIO_CONSOLE_PORT=9001

# --- Mailpit (local SMTP capture, PRD §21.5) ---
# Host port for SMTP submission.
MAILPIT_SMTP_PORT=1025
# Host port for the web UI that shows captured mail.
MAILPIT_UI_PORT=8025
